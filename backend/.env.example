# --- Base de datos (si lo dejás vacío, corre en memoria para probar) ---
MONGODB_URI=mongodb+srv://usuario:pass@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lalista

# --- Clave del panel /admin (poné algo largo y secreto) ---
ADMIN_TOKEN=poné-una-clave-larga-y-secreta

# --- Mercado Pago (Credenciales de producción de tu cuenta) ---
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
PRICE_ARS=1500

# --- URLs públicas (se completan después del deploy) ---
PUBLIC_API_URL=https://la-lista-api.onrender.com
PUBLIC_WEB_URL=https://la-lista.netlify.app
CORS_ORIGINS=https://la-lista.netlify.app
